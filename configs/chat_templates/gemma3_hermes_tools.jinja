{#- Gemma-3 chat template + Hermes/Qwen2.5-style tool calling (App. agentharm).
    Gemma-3's own template has no tool support. Tools are described in the first user turn with the
    exact Qwen2.5 tool instructions; the model answers with <tool_call>{json}</tool_call> blocks
    (parsed by src/bias_em/agents/tool_parser.py, as for Qwen); tool results come back
    as a user turn of <tool_response> blocks. Consecutive tool messages are merged so that Gemma's
    strict user/model alternation holds. -#}
{{- bos_token -}}
{%- set ns = namespace(sys='', first=true, in_tool=false, tools='') -%}
{%- if messages[0]['role'] == 'system' -%}
  {%- set ns.sys = messages[0]['content'] if messages[0]['content'] is string else messages[0]['content'][0]['text'] -%}
  {%- set loop_messages = messages[1:] -%}
{%- else -%}
  {%- set loop_messages = messages -%}
{%- endif -%}
{%- if tools -%}
  {%- set ns.tools = "# Tools\n\nYou may call one or more functions to assist with the user query.\n\nYou are provided with function signatures within <tools></tools> XML tags:\n<tools>" -%}
  {%- for t in tools -%}{%- set ns.tools = ns.tools + "\n" + (t | tojson) -%}{%- endfor -%}
  {%- set ns.tools = ns.tools + "\n</tools>\n\nFor each function call, return a json object with function name and arguments within <tool_call></tool_call> XML tags:\n<tool_call>\n{\"name\": <function-name>, \"arguments\": <args-json-object>}\n</tool_call>" -%}
  {%- set ns.sys = (ns.sys + "\n\n" if ns.sys else "") + ns.tools -%}
{%- endif -%}
{%- for m in loop_messages -%}
  {%- set content = m['content'] if m['content'] is string else ((m['content'] | map(attribute='text') | join('')) if m['content'] else '') -%}
  {%- if m['role'] == 'tool' -%}
    {%- if not ns.in_tool -%}{{- '<start_of_turn>user\n' -}}{%- set ns.in_tool = true -%}{%- else -%}{{- '\n' -}}{%- endif -%}
    {{- '<tool_response>\n' + content + '\n</tool_response>' -}}
    {%- if loop.last or loop_messages[loop.index0 + 1]['role'] != 'tool' -%}{{- '<end_of_turn>\n' -}}{%- set ns.in_tool = false -%}{%- endif -%}
  {%- elif m['role'] == 'user' -%}
    {{- '<start_of_turn>user\n' -}}
    {%- if ns.first and ns.sys -%}{{- ns.sys + '\n\n' -}}{%- endif -%}
    {%- set ns.first = false -%}
    {{- content | trim -}}{{- '<end_of_turn>\n' -}}
  {%- elif m['role'] == 'assistant' -%}
    {{- '<start_of_turn>model\n' -}}{{- content | trim -}}
    {%- if m['tool_calls'] -%}
      {%- for tc in m['tool_calls'] -%}
        {%- set f = tc['function'] if tc['function'] is defined else tc -%}
        {%- set args = f['arguments'] if f['arguments'] is string else (f['arguments'] | tojson) -%}
        {{- ('\n' if (content | trim) or not loop.first else '') + '<tool_call>\n{"name": "' + f['name'] + '", "arguments": ' + args + '}\n</tool_call>' -}}
      {%- endfor -%}
    {%- endif -%}
    {{- '<end_of_turn>\n' -}}
  {%- endif -%}
{%- endfor -%}
{%- if add_generation_prompt -%}{{- '<start_of_turn>model\n' -}}{%- endif -%}
